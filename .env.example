# Copia este archivo como ".env" (no se sube a git) y completa los valores.
# También puedes crearlo con preguntas guiadas: python scripts/configurar_env.py

# Genera una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# Va entre comillas simples porque puede traer caracteres como # o $
SECRET_KEY='tu_clave_generada'
# True mientras desarrollas en tu computador. En producción: False
DEBUG=True
# Dominios permitidos, separados por coma (con DEBUG=True puede quedar vacío)
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos MySQL (requiere MySQL 8.0 o superior)
DB_NAME=rodamar_db
DB_USER=rodamar_user
DB_PASSWORD='tu_password_segura'
DB_HOST=localhost
DB_PORT=3306

# Correo: por defecto se imprime en la consola de runserver (no se envía nada real)
EMAIL_BACKEND=usuarios.correo_consola.EmailBackend
DEFAULT_FROM_EMAIL="RODAMAR <no-responder@rodamar.local>"

# Para enviar correos reales, borra las 2 líneas anteriores y completa estas.
# El remitente debe ser la misma dirección que EMAIL_HOST_USER.
# Pruébalo con: python manage.py probar_correo tu.correo@ejemplo.cl
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu.correo@ejemplo.cl
# EMAIL_HOST_PASSWORD='tu_contraseña'
# DEFAULT_FROM_EMAIL="RODAMAR <tu.correo@ejemplo.cl>"
